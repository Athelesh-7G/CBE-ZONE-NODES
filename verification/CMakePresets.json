{
  "version": 3,
  "cmakeMinimumRequired": { "major": 3, "minor": 21, "patch": 0 },
  "configurePresets": [
    {
      "name": "release",
      "displayName": "Release",
      "binaryDir": "${sourceDir}/build/release",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    },
    {
      "name": "asan-ubsan",
      "displayName": "Debug + AddressSanitizer + UndefinedBehaviorSanitizer",
      "binaryDir": "${sourceDir}/build/asan-ubsan",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "RelWithDebInfo", "CBE_SANITIZE": "ON" }
    },
    {
      "name": "fuzz",
      "displayName": "libFuzzer (clang only)",
      "binaryDir": "${sourceDir}/build/fuzz",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CBE_FUZZ": "ON",
        "CMAKE_CXX_COMPILER": "clang++"
      }
    }
  ],
  "buildPresets": [
    { "name": "release", "configurePreset": "release" },
    { "name": "asan-ubsan", "configurePreset": "asan-ubsan" },
    { "name": "fuzz", "configurePreset": "fuzz" }
  ]
}
